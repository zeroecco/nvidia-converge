{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeroecco/nvidia-converge/schemas/integration-results.schema.json",
  "title": "nvidia-converge integration results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "release", "generated_at", "commit", "operator", "overall_status", "qualification_wheel", "runs", "qualified_platforms", "recipe_path_coverage", "required_coverage"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.5"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "overall_status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked"]
    },
    "qualification_wheel": {
      "$ref": "#/$defs/qualification_wheel"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/run"}
    },
    "qualified_platforms": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/platform_tuple"}
    },
    "recipe_path_coverage": {
      "$ref": "#/$defs/recipe_path_coverage"
    },
    "required_coverage": {
      "$ref": "#/$defs/required_coverage"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "uri", "sha256"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "uri": {"type": "string", "format": "uri", "pattern": "^https://api\\.github\\.com/"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "qualification_wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^nvidia_converge-[0-9][0-9A-Za-z.]*-py3-none-any\\.whl$", "maxLength": 200},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "platform_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_id", "os_version", "package_manager"],
      "properties": {
        "os_id": {"type": "string", "enum": ["ubuntu", "debian", "rhel", "rocky", "almalinux", "centos", "sles", "opensuse-leap"]},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"},
        "package_manager": {"type": "string", "enum": ["apt-get", "dnf", "yum", "zypper"]}
      }
    },
    "recipe_path_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apt_get", "dnf", "zypper"],
      "properties": {
        "apt_get": {"type": "boolean"},
        "dnf": {"type": "boolean"},
        "zypper": {"type": "boolean"}
      }
    },
    "required_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secure_boot", "fabric_manager", "mig_toggle", "install_apply", "rollback_apply", "policy_rollback_apply", "policy_rollback_state_verify"],
      "properties": {
        "secure_boot": {"type": "boolean"},
        "fabric_manager": {"type": "boolean"},
        "mig_toggle": {"type": "boolean"},
        "install_apply": {"type": "boolean"},
        "rollback_apply": {"type": "boolean"},
        "policy_rollback_apply": {"type": "boolean"},
        "policy_rollback_state_verify": {"type": "boolean"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "matrix_id", "workflow_run", "workflow_run_id", "workflow_run_attempt", "workflow_job", "workflow_job_id", "workflow_path", "head_sha", "runner_labels", "os_id", "os_version", "package_manager", "qualification_wheel", "desired", "apply", "status", "started_at", "completed_at", "capabilities", "scenarios", "artifacts", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
        "matrix_id": {"type": "string", "enum": ["ubuntu-24.04", "rhel-9", "sles-15", "secure-boot", "fabric-manager", "mig-toggle"]},
        "workflow_run": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "workflow_run_attempt": {"type": "integer", "minimum": 1},
        "workflow_job": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "workflow_job_id": {"type": "integer", "minimum": 1},
        "workflow_path": {"type": "string", "const": ".github/workflows/production-gpu-qualification.yml"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runner_labels": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 100}, "minItems": 1, "maxItems": 32, "uniqueItems": true},
        "os_id": {"type": "string", "enum": ["ubuntu", "debian", "rhel", "rocky", "almalinux", "centos", "sles", "opensuse-leap"]},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"},
        "package_manager": {"type": "string", "enum": ["apt-get", "dnf", "yum", "zypper"]},
        "qualification_wheel": {"$ref": "#/$defs/qualification_wheel"},
        "desired": {"type": "string", "pattern": "^examples/[A-Za-z0-9][A-Za-z0-9._-]{0,199}\\.yaml$"},
        "apply": {"type": "boolean"},
        "status": {"type": "string", "enum": ["passed", "failed", "blocked"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "artifacts": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "notes": {"type": "string", "maxLength": 4000}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secure_boot", "fabric_manager", "mig_capable", "mig_toggle"],
      "properties": {
        "secure_boot": {"type": "boolean"},
        "fabric_manager": {"type": "boolean"},
        "mig_capable": {"type": "boolean"},
        "mig_toggle": {"type": "boolean"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "report"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "doctor",
            "doctor_missing_headers",
            "doctor_module_unloaded",
            "doctor_driver_mismatch",
            "doctor_runtime_missing",
            "doctor_fabric_manager_inactive",
            "plan",
            "install_apply",
            "verify_apply",
            "lock_apply",
            "snapshot",
            "rollback_apply",
            "rollback_state_verify",
            "policy_rollback_apply",
            "policy_rollback_state_verify",
            "report_schema"
          ]
        },
        "status": {"type": "string", "enum": ["passed", "failed", "blocked", "not_applicable"]},
        "report": {"type": ["string", "null"], "maxLength": 512, "pattern": "^reports/[A-Za-z0-9._/-]+\\.json$"}
      }
    }
  }
}
