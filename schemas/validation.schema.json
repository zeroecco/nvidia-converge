{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeroecco/nvidia-converge/schemas/validation.schema.json",
  "title": "nvidia-converge validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "valid", "desired"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid": {
      "type": "boolean",
      "const": true
    },
    "desired": {
      "$ref": "#/$defs/desired"
    }
  },
  "$defs": {
    "desired": {
      "type": "object",
      "required": ["role", "driver", "cuda_compat", "secure_boot", "container_runtime", "container_test_image", "fabric_manager", "mig", "mig_profile", "kernel_policy"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "enum": ["compute"]},
        "driver": {"type": "string", "pattern": "^\\d+(?:-open|\\.\\d+(?:\\.\\d+)?)?$"},
        "cuda_compat": {"type": "string", "enum": ["none"]},
        "secure_boot": {"type": "string", "enum": ["signed", "disabled"]},
        "container_runtime": {"type": "string", "enum": ["docker"]},
        "container_test_image": {"type": "string", "maxLength": 212, "pattern": "^nvidia/cuda:\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9._]+)*-devel(?:-[A-Za-z0-9._]+)*@sha256:[a-f0-9]{64}$"},
        "fabric_manager": {"type": "boolean"},
        "mig": {"type": "string", "enum": ["disabled", "enabled"]},
        "mig_profile": {"type": "string", "enum": ["none", "full"]},
        "kernel_policy": {"type": "string", "enum": ["pin-compatible"]}
      },
      "allOf": [
        {"if": {"properties": {"mig": {"const": "enabled"}}}, "then": {"properties": {"mig_profile": {"const": "full"}}}},
        {"if": {"properties": {"mig": {"const": "disabled"}}}, "then": {"properties": {"mig_profile": {"const": "none"}}}}
      ]
    }
  }
}
