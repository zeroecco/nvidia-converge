{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zeroecco/nvidia-converge/schemas/desired.schema.json",
  "title": "nvidia-converge desired state",
  "oneOf": [
    {
      "$ref": "#/$defs/desired"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desired": {
          "$ref": "#/$defs/desired"
        }
      },
      "required": ["desired"]
    }
  ],
  "$defs": {
    "desired": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["compute"],
          "default": "compute"
        },
        "driver": {
          "type": "string",
          "pattern": "^\\d+(?:-open|\\.\\d+(?:\\.\\d+)?)?$",
          "default": "580-open",
          "examples": ["580-open", "595.71.05"]
        },
        "cuda_compat": {
          "type": "string",
          "enum": ["none"],
          "default": "none"
        },
        "secure_boot": {
          "type": "string",
          "enum": ["signed", "disabled"],
          "default": "signed"
        },
        "container_runtime": {
          "type": "string",
          "enum": ["docker"],
          "default": "docker"
        },
        "container_test_image": {
          "type": "string",
          "maxLength": 212,
          "pattern": "^nvidia/cuda:\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9._]+)*-devel(?:-[A-Za-z0-9._]+)*@sha256:[a-f0-9]{64}$",
          "default": "nvidia/cuda:13.1.2-devel-ubuntu22.04@sha256:d8332c008e2ef270e82d286e5245e771f839645683075bba21ad9e4fa59dbcbb"
        },
        "fabric_manager": {
          "type": "boolean",
          "default": false
        },
        "mig": {
          "type": "string",
          "enum": ["disabled", "enabled"],
          "default": "disabled"
        },
        "mig_profile": {
          "type": "string",
          "enum": ["none", "full"],
          "default": "none"
        },
        "kernel_policy": {
          "type": "string",
          "enum": ["pin-compatible"],
          "default": "pin-compatible"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mig": {"const": "enabled"}}, "required": ["mig"]},
          "then": {"properties": {"mig_profile": {"const": "full"}}, "required": ["mig_profile"]}
        },
        {
          "if": {"properties": {"mig": {"const": "disabled"}}, "required": ["mig"]},
          "then": {"properties": {"mig_profile": {"const": "none"}}}
        },
        {
          "if": {"properties": {"mig_profile": {"const": "full"}}, "required": ["mig_profile"]},
          "then": {"properties": {"mig": {"const": "enabled"}}, "required": ["mig"]}
        }
      ]
    }
  }
}
